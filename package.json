{
  "name": "streaming",
  "version": "1.0.0",
  "description": "",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "pnpm exec drizzle-kit generate --config=config/drizzle.config.ts",
    "db:migrate": "pnpm exec drizzle-kit migrate --config=config/drizzle.config.ts",
    "db:studio": "pnpm exec drizzle-kit studio --config=config/drizzle.config.ts",
    "db:drop": "pnpm exec drizzle-kit drop --config=config/drizzle.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "bullmq": "^6.3.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "express-status-monitor": "^1.3.4",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^6.0.0",
    "node-media-server": "^4.3.2",
    "pg": "^8.23.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-status-monitor": "^1.3.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.4.0",
    "@types/node-media-server": "^2.3.7",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
